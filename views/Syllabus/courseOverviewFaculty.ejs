<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Courses</title>
    <link rel="icon" type="image/x-icon" href="/common/img/chalkboardLogo.ico">
    <link rel="stylesheet" href="/common/css/variables.css?v=<%= new Date().getTime() %>">
    <link rel="stylesheet" href="/Syllabus/css/syllabus.css">
    <link rel="stylesheet" href="/Syllabus/css/courseOverviewFaculty.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body>
    <div class="dashboard">
        <%- include('../partials/sideMenuBar') %>

            <main class="main-content" style="background: #ffffff !important;">

                <section class="content-panel">
                    <div class="overview-panel">

                        <div class="courses-header">
                            <div class="header-left">
                                <h1>Courses</h1>
                                <div class="view-toggles">
                                    <button class="toggle-btn list-view"><i class="fas fa-bars"></i></button>
                                    <button class="toggle-btn grid-view active"><i class="fas fa-th-large"></i></button>
                                </div>
                            </div>

                            <div class="header-center">
                                <div class="search-container"
                                    data-userid="<%= typeof userId !== 'undefined' ? userId : '' %>">
                                    <i class="fas fa-search"></i>
                                    <input type="text" id="searchInput" placeholder="Search your Courses"
                                        autocomplete="off">
                                </div>

                                <div class="control-group terms-group"><label>Terms</label><select>
                                        <option>A.Y. 2025-2026 | COLLEGE | 2nd Trimester</option>
                                    </select></div>
                                <div class="control-group filters-group"><label>Filters</label><select>
                                        <option>All Courses</option>
                                    </select></div>
                            </div>

                            <div class="header-right">
                                <div class="control-group items-per-page"><label>Items per Page</label><select>
                                        <option><%= typeof courses !== 'undefined' ? courses.length : 0 %></option>
                                    </select></div>
                                <button onclick="window.location.href='/syllabus/tracking'" 
                                    style="background-color: var(--accent-primary); color: white; border: none; padding: 0 16px; border-radius: 8px; cursor: pointer; font-size: 13px; font-weight: 500; display: inline-flex; align-items: center; gap: 8px; height: 36px; margin-left: 10px;">
                                    <i class="fas fa-chart-line"></i> Syllabus Tracking
                                </button>
                                <button onclick="openReviewFormModal()" 
                                    style="background-color: var(--accent-secondary); color: white; border: none; padding: 0 16px; border-radius: 8px; cursor: pointer; font-size: 13px; font-weight: 500; display: inline-flex; align-items: center; gap: 8px; height: 36px; margin-left: 10px;">
                                    <i class="fas fa-file-contract"></i> Syllabus Review Form
                                </button>
                            </div>
                        </div>

                        <div class="results-bar">
                            <span class="result-count" id="resultCount">
                                <%= typeof courses !=='undefined' ? courses.length : 0 %> Results
                            </span>
                        </div>

                        <div class="course-grid">
                            <% if (typeof courses !=='undefined' && courses.length> 0) { %>
                                <% courses.forEach(course=> { %>
                                    <div class="course-card" data-id="<%= course.id %>"
                                        data-hasdraft="<%= course.hasDraft %>"
                                        data-status="<%= course.status || 'No Syllabus Draft' %>"
                                        data-title="<%= course.title %>"
                                        data-pcremarks="<%= course.pcRemarks || '' %>"
                                        data-deanremarks="<%= course.deanRemarks || '' %>"
                                        data-hrremarks="<%= course.hrRemarks || '' %>">
                                        <div class="card-image">
                                            <img src="<%= course.img || 'https://picsum.photos/400/200?random=' + course.id %>"
                                                alt="Course Image">
                                        </div>
                                        <div class="card-content">
                                            <span class="course-code"><%= course.code %></span>
                                            <h3 class="course-title"><%= course.title %></h3>
                                            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px;">
                                                <%
                                                    var rawStatus = course.status || 'No Syllabus Draft';
                                                    var statusClass = 'status-no-draft';
                                                    var statusLabel = rawStatus;
                                                    if (rawStatus === 'Draft') { statusClass = 'status-draft'; statusLabel = '<span style="color:#9ca3af;font-weight:600;">Saved as Draft</span>'; }
                                                    else if (rawStatus === 'Pending Endorsement' || rawStatus === 'Pending Faculty Signature') { statusClass = 'status-pending'; statusLabel = (rawStatus === 'Pending Endorsement' ? 'Pending' : rawStatus); }
                                                    else if (rawStatus === 'Pending') { statusClass = 'status-pending'; statusLabel = 'Pending'; }
                                                    else if (rawStatus === 'Signed by Faculty') { statusClass = 'status-pending'; statusLabel = 'Pending'; }
                                                    else if (rawStatus === 'Endorsed' || rawStatus === 'Endorsed to Dean') { statusClass = 'status-endorsed'; statusLabel = 'Endorsed'; }
                                                    else if (rawStatus === 'Approved') { statusClass = 'status-approved'; statusLabel = 'Approved'; }
                                                    else if (rawStatus === 'Archived') { statusClass = 'status-archived'; statusLabel = 'Archived'; }
                                                    else if (rawStatus === 'Rejected' || rawStatus === 'Returned') { statusClass = 'status-rejected'; statusLabel = rawStatus; }
                                                    else if (rawStatus === 'Returned to PC') { statusClass = 'status-returned'; statusLabel = 'Returned to PC'; }
                                                %>
                                                <p class="course-status <%= statusClass %>">
                                                    <%- statusLabel %>
                                                    <% if (rawStatus !== 'No Syllabus Draft') { %>
                                                    <span style="display: block; margin-top: 6px; font-size: 11px; color: #555; border-top: 1px dashed #e0e0e0; padding-top: 6px; font-style: normal; font-weight: normal; line-height: 1.4;">
                                                        <span style="margin-bottom: 3px; display: flex; align-items: center; width: 100%;">
                                                            <i class="fas fa-comment-dots" style="color: #1565c0; margin-right: 4px; flex-shrink: 0;"></i>
                                                            <strong style="color: #1565c0; margin-right: 4px; flex-shrink: 0;">PC:</strong>
                                                            <span style="font-style: italic; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex-grow: 1;"><%= course.pcRemarks || 'no feedback' %></span>
                                                        </span>
                                                        <span style="margin-bottom: 3px; display: flex; align-items: center; width: 100%;">
                                                            <i class="fas fa-comment-dots" style="color: #2e7d32; margin-right: 4px; flex-shrink: 0;"></i>
                                                            <strong style="color: #2e7d32; margin-right: 4px; flex-shrink: 0;">Dean:</strong>
                                                            <span style="font-style: italic; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex-grow: 1;"><%= course.deanRemarks || 'no feedback' %></span>
                                                        </span>
                                                        <span style="margin-bottom: 3px; display: flex; align-items: center; width: 100%;">
                                                            <i class="fas fa-comment-dots" style="color: #6a1b9a; margin-right: 4px; flex-shrink: 0;"></i>
                                                            <strong style="color: #6a1b9a; margin-right: 4px; flex-shrink: 0;">HR/Admin:</strong>
                                                            <span style="font-style: italic; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex-grow: 1;"><%= course.hrRemarks || 'no feedback' %></span>
                                                        </span>
                                                    </span>
                                                    <% } %>
                                                </p>
                                            </div>
                                        </div>
                                        <div class="card-footer">
                                            <span class="instructor">
                                                <%= course.instructor %>
                                            </span>
                                        </div>
                                    </div>
                                    <% }); %>
                                        <% } else { %>
                                            <p
                                                style="text-align: center; color: #777; grid-column: 1 / -1; padding: 40px 0;">
                                                No courses found.</p>
                                            <% } %>
                        </div>
                    </div>
                </section>
            </main>
    </div>

    <div class="modal-overlay" id="draftModal">
        <div class="modal-content" style="width: 460px; text-align: center;">
            <div class="modal-header" style="justify-content: space-between;">
                <div class="modal-title-group">
                    <div class="modal-icon"><i class="fas fa-file-alt"></i></div>
                    <h2 id="draftModalTitle">Syllabus Draft</h2>
                </div>
                <span class="close-modal" onclick="closeDraftModal()">&times;</span>
            </div>

            <div style="padding: 30px 20px; text-align: center;">
                <p id="draftMessage" style="font-size: 16px; font-weight: 600; color: #444; margin: 0;"></p>
            </div>

            <div class="modal-actions" style="justify-content: center; flex-direction: column; gap: 8px;">
                <button id="draftActionBtn" class="submit-btn" style="width: 100%; justify-content: center;">
                </button>
                <button id="draftDownloadBtn" class="submit-btn" style="width: 100%; justify-content: center; background: #2e7d32; display: none;">
                    <i class="fas fa-download" style="margin-right: 6px;"></i> Download PDF
                </button>
            </div>
        </div>
    </div>

    <!-- =====================================================
         FACULTY SIGNATURE MODAL — shown for verified syllabi
    ====================================================== -->
    <div class="modal-overlay" id="signatureModal">
        <div class="modal-content" style="width: 560px; text-align: left;">
            <div class="modal-header" style="justify-content: space-between;">
                <div class="modal-title-group">
                    <div class="modal-icon" style="background: #b30000;">
                        <i class="fas fa-signature"></i>
                    </div>
                    <h2 style="font-size: 20px;">Sign Before Download</h2>
                </div>
                <span class="close-modal" onclick="closeSignatureModal()">&times;</span>
            </div>

            <div style="padding: 16px 4px 0; font-size: 13px; color: #666; line-height: 1.5;">
                <p style="margin: 0 0 10px;">
                    <i class="fas fa-info-circle" style="color: #b30000; margin-right: 4px;"></i>
                    As the <strong>Course Coordinator / Faculty</strong>, you must sign below before downloading
                    the final syllabus PDF. Your signature will appear in the <em>"Prepared By"</em> section.
                </p>
            </div>

            <!-- Signature Canvas -->
            <div style="margin-top: 10px;">
                <div style="font-weight: 700; font-size: 13px; margin-bottom: 8px; color: #333;">
                    Draw your signature below
                </div>
                <canvas id="facultySigCanvas" style="
                    width: 100%;
                    height: 180px;
                    border: 2px dashed #d1d5db;
                    border-radius: 12px;
                    background: #fff;
                    cursor: crosshair;
                    display: block;
                "></canvas>

                <div style="display: flex; gap: 10px; margin-top: 12px; flex-wrap: wrap;">
                    <button type="button" class="submit-btn" id="sigClearBtn"
                        style="background: #e5e7eb; color: #333; flex: 0; padding: 9px 20px; font-size: 13px;">
                        <i class="fas fa-eraser" style="margin-right: 4px;"></i> Clear
                    </button>
                    <button type="button" class="submit-btn" id="sigSaveBtn"
                        style="background: #b30000; flex: 1; justify-content: center; font-size: 13px;">
                        <i class="fas fa-check" style="margin-right: 6px;"></i> Sign &amp; Download PDF
                    </button>
                </div>

                <div id="sigStatusMsg" style="margin-top: 10px; font-size: 12px; min-height: 18px;"></div>
            </div>

            <!-- Already-signed preview (hidden by default) -->
            <div id="sigAlreadySigned" style="display: none; margin-top: 10px; text-align: center;">
                <div style="font-weight: 700; font-size: 13px; margin-bottom: 8px; color: #333;">
                    ✅ You have already signed this syllabus
                </div>
                <div style="background: #f9f9f9; border: 1px solid #e5e7eb; border-radius: 12px; padding: 14px; display: inline-block;">
                    <img id="sigPreviewImg" src="" alt="Faculty Signature"
                        style="max-height: 80px; max-width: 100%; object-fit: contain;" />
                </div>
                <div style="margin-top: 14px;">
                    <button type="button" class="submit-btn" id="sigDownloadDirectBtn"
                        style="background: #2e7d32; width: 100%; justify-content: center; font-size: 13px;">
                        <i class="fas fa-download" style="margin-right: 6px;"></i> Download PDF
                    </button>
                    <button type="button" class="submit-btn" id="sigResignBtn"
                        style="background: #e5e7eb; color: #333; width: 100%; justify-content: center; font-size: 12px; margin-top: 6px;">
                        <i class="fas fa-redo" style="margin-right: 4px;"></i> Re-sign
                    </button>
                </div>
            </div>
        </div>
    </div>
    </div>

    <!-- Syllabus Review Form Modal -->
    <div class="modal-overlay" id="reviewFormModal">
        <div class="modal-content" style="width: 600px; text-align: left;">
            <div class="modal-header" style="justify-content: space-between;">
                <div class="modal-title-group">
                    <div class="modal-icon" style="background: var(--accent-secondary);"><i class="fas fa-file-contract"></i></div>
                    <h2>Syllabus Review Form</h2>
                </div>
                <span class="close-modal" onclick="closeReviewFormModal()">&times;</span>
            </div>
            <div style="padding: 20px; font-size: 14px; color: #333; text-align: left; max-height: 400px; overflow-y: auto; background: #f9f9f9; border: 1px solid #ddd; margin: 10px; border-radius: 4px;">
                <h3 style="text-align: center; border-bottom: 2px solid var(--accent-primary); padding-bottom: 10px; margin-bottom: 15px;">Syllabus Review Form (Template)</h3>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 15px;">
                    <div><strong>Course Title:</strong> _________________</div>
                    <div><strong>Course Code:</strong> _________________</div>
                    <div><strong>Instructor:</strong> _________________</div>
                    <div><strong>Date Reviewed:</strong> _________________</div>
                </div>
                
                <h4 style="margin-bottom: 10px; color: var(--accent-secondary);">I. Content & Alignment</h4>
                <ul style="list-style: none; padding-left: 0; margin-bottom: 15px;">
                    <li style="margin-bottom: 5px;"><input type="checkbox" disabled style="margin-right: 8px;"> Course Description matches the approved curriculum</li>
                    <li style="margin-bottom: 5px;"><input type="checkbox" disabled style="margin-right: 8px;"> Course Outcomes are clearly stated and measurable</li>
                    <li style="margin-bottom: 5px;"><input type="checkbox" disabled style="margin-right: 8px;"> Assessment tasks align with the Course Outcomes</li>
                    <li style="margin-bottom: 5px;"><input type="checkbox" disabled style="margin-right: 8px;"> Grading system is clearly defined and accurate</li>
                </ul>

                <h4 style="margin-bottom: 10px; color: var(--accent-secondary);">II. Schedule & Resources</h4>
                <ul style="list-style: none; padding-left: 0; margin-bottom: 15px;">
                    <li style="margin-bottom: 5px;"><input type="checkbox" disabled style="margin-right: 8px;"> Weekly schedule covers all required topics</li>
                    <li style="margin-bottom: 5px;"><input type="checkbox" disabled style="margin-right: 8px;"> Teaching & Learning Activities are appropriate</li>
                    <li style="margin-bottom: 5px;"><input type="checkbox" disabled style="margin-right: 8px;"> References and textbooks are updated (last 5 years)</li>
                </ul>

                <h4 style="margin-bottom: 10px; color: var(--accent-secondary);">III. Reviewer Remarks</h4>
                <div style="width: 100%; height: 60px; border: 1px dashed #ccc; background: white; margin-bottom: 15px;"></div>

                <div style="display: flex; justify-content: space-between; margin-top: 30px;">
                    <div style="text-align: center;">
                        <div style="border-bottom: 1px solid #000; width: 200px; margin-bottom: 5px;"></div>
                        <small>Reviewer's Signature over Printed Name</small>
                    </div>
                </div>
            </div>
            <div class="modal-actions" style="justify-content: center;">
                <button type="button" class="submit-btn" style="background: #e5e7eb; color: #333;" onclick="closeReviewFormModal()">Close</button>
            </div>
        </div>
    </div>
    <script>
        function openReviewFormModal() {
            document.getElementById('reviewFormModal').style.display = 'flex';
        }
        function closeReviewFormModal() {
            document.getElementById('reviewFormModal').style.display = 'none';
        }
    </script>

    <script src="/Syllabus/js/courseFaculty.js?v=<%= new Date().getTime() %>"></script>
    <script src="/Syllabus/js/coAssessmentEvaluation.js?v=<%= new Date().getTime() %>"></script>
</body>

</html>
