<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Review Syllabus</title>
    <link rel="icon" type="image/x-icon" href="/common/img/chalkboardLogo.ico">

    <!-- School palette variables -->
    <link rel="stylesheet" href="/common/css/variables.css">
    <!-- Material icons -->
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <!-- Approval detail page styles -->
    <link rel="stylesheet" href="/Syllabus/css/syllabusApprovalDetail.css">
</head>

<body>

    <main class="approval-detail-main">
        <div class="background-overlay"></div>

        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
             HEADER BAR â€” Course Info + School Logo
        â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <header class="approval-detail-header">
            <div class="ad-header-logo">
                <img src="/common/img/schoolLogo.png" alt="School Logo">
            </div>
            <div class="ad-header-divider"></div>
            <div class="ad-header-info">
                <h1 class="ad-course-name">
                    <%= locals.courseName || '[COURSE NAME]' %>
                </h1>
                <p class="ad-course-meta">
                    <span class="meta-item">
                        <%= locals.courseCode || '[COURSE CODE]' %>
                    </span>
                </p>
            </div>
        </header>

        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
             BODY LAYOUT â€” Left (Document) + Right (Sidebar Panel)
        â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <div class="approval-detail-body">

            <!-- â”€â”€â”€ LEFT: Document Preview â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <section class="ad-document-panel">

                <!-- Back button -->
                <a href="/syllabus/hr" class="ad-back-btn">
                    <span class="material-symbols-outlined">arrow_back</span> BACK
                </a>

                <div class="ad-file-type-badge">
                    <%= locals.courseCode || '[COURSE CODE]' %>
                </div>

                <h2 class="ad-section-title"><%= locals.courseName || '[COURSE NAME]' %></h2>

                <!-- â”€â”€ Document Read-Only Preview â”€â”€ -->
                <div class="ad-document-preview ad-doc-content">
                    
                    <h3 class="ad-section-heading" data-section-key="course_details">Course Details</h3>
                    <table class="ad-data-table ad-data-table-wide">
                        <tr><td style="font-weight:bold; width: 30%; background:#f9f9f9;">Course Code</td><td><%= locals.courseCode %></td></tr>
                        <tr><td style="font-weight:bold; background:#f9f9f9;">Course Title</td><td><%= locals.courseName %></td></tr>
                        <tr><td style="font-weight:bold; background:#f9f9f9;">AY / Term</td><td><%= locals.syl && locals.syl.schoolYear ? locals.syl.schoolYear : '' %> / <%= locals.syl && locals.syl.term ? locals.syl.term : '' %></td></tr>
                        <tr><td style="font-weight:bold; background:#f9f9f9;">Pre-requisite</td><td><%= locals.syl && locals.syl.preRequisite ? locals.syl.preRequisite : 'None' %></td></tr>
                        <tr><td style="font-weight:bold; background:#f9f9f9;">Co-requisite</td><td><%= locals.syl && locals.syl.coRequisite ? locals.syl.coRequisite : 'None' %></td></tr>
                        <tr><td style="font-weight:bold; background:#f9f9f9;">Credit Units</td><td><%= locals.syl && locals.syl.units ? locals.syl.units : 'N/A' %></td></tr>
                        <tr><td style="font-weight:bold; background:#f9f9f9;">Lecture Hours/Week</td><td><%= (locals.syl && locals.syl.lectureHours && locals.syl.lectureHours !== '0') ? locals.syl.lectureHours : '-' %></td></tr>
                        <tr><td style="font-weight:bold; background:#f9f9f9;">Laboratory Hours/Week</td><td><%= (locals.syl && locals.syl.labHours && locals.syl.labHours !== '0') ? locals.syl.labHours : '-' %></td></tr>
                        <tr><td style="font-weight:bold; background:#f9f9f9;">Course Design</td><td><%= locals.syl && locals.syl.courseDesign ? locals.syl.courseDesign : 'Not set' %></td></tr>
                    </table>

                    <h3 class="ad-section-heading" data-section-key="course_desc">Course Description</h3>
                    <div style="text-align: justify; margin-bottom: 20px; font-size: 0.9rem; line-height: 1.5; color: #333;">
                        <%= locals.syl && locals.syl.courseDescription ? locals.syl.courseDescription : 'No course description provided.' %>
                    </div>

                    <h3 class="ad-section-heading" data-section-key="peo">Program Educational Objectives (PEO)</h3>
                    <% if (locals.peos && locals.peos.length > 0 && locals.peos[0].description) { %>
                        <table class="ad-data-table">
                            <thead>
                                <tr>
                                    <th style="width:10%; text-align: center;">PEO</th>
                                    <th style="text-align: left;">Description</th>
                                    <th style="width:20%; text-align: center;">Mission Mapping</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% locals.peos[0].description.forEach(function(desc, index) { 
                                     const rating = locals.peos[0].rating && locals.peos[0].rating[index];
                                %>
                                    <tr>
                                        <td style="font-weight:bold; text-align:center;"><%= index + 1 %></td>
                                        <td><%= desc %></td>
                                        <td style="text-align:center;">
                                            <% if (rating && rating.length === 3) { %>
                                                <%= (rating[0]==='1'?'A ':'') + (rating[1]==='1'?'B ':'') + (rating[2]==='1'?'C':'') || '-' %>
                                            <% } else { %>
                                                <%= rating || '-' %>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <p class="ad-no-content">No program educational objectives provided.</p>
                    <% } %>

                    <h3 class="ad-section-heading" data-section-key="so">Student Outcomes (SO)</h3>
                    <% if (locals.seos && locals.seos.length > 0 && locals.seos[0].description) { %>
                        <table class="ad-data-table">
                            <thead>
                                <tr>
                                    <th style="width:10%; text-align: center;">SO</th>
                                    <th style="text-align: left;">Description</th>
                                    <th style="width:20%; text-align: center;">PEO Mapping</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% locals.seos[0].description.forEach(function(desc, index) { 
                                     const rating = locals.seos[0].rating && locals.seos[0].rating[index];
                                     const letter = String.fromCharCode(97 + index);
                                %>
                                    <tr>
                                        <td style="font-weight:bold; text-align:center;"><%= letter %></td>
                                        <td><%= desc %></td>
                                        <td style="text-align:center;">
                                            <% if (rating && rating.length === 3) { %>
                                                <%= (rating[0]==='1'?'1 ':'') + (rating[1]==='1'?'2 ':'') + (rating[2]==='1'?'3':'') || '-' %>
                                            <% } else { %>
                                                <%= rating || '-' %>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <p class="ad-no-content">No student outcomes provided.</p>
                    <% } %>

                    <h3 class="ad-section-heading" data-section-key="co">Course Outcomes (CO)</h3>
                    <% if (locals.cos && locals.cos.length > 0) { %>
                        <table class="ad-data-table">
                            <thead>
                                <tr>
                                    <th style="width:15%; text-align: center;">CO. No</th>
                                    <th style="text-align: left;">Description</th>
                                    <th style="width:25%; text-align: left;">Thinking Skills</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% locals.cos.forEach(function(co) { %>
                                    <tr>
                                        <td style="font-weight:bold; text-align:center;"><%= co.coNumber %></td>
                                        <td><%= co.description %></td>
                                        <td><%= co.thinkingSkills %></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <p class="ad-no-content">No course outcomes provided.</p>
                    <% } %>

                    <h3 class="ad-section-heading" data-section-key="mapping">Course Mapping</h3>
                    <% if (locals.mappings && locals.mappings.length > 0) { %>
                        <table class="ad-data-table" style="text-align: center;">
                            <thead>
                                <tr>
                                    <th>CO</th>
                                    <th>a</th>
                                    <th>b</th>
                                    <th>c</th>
                                    <th>d</th>
                                    <th>e</th>
                                    <th>f</th>
                                    <th>g</th>
                                    <th>h</th>
                                    <th>i</th>
                                    <th>j</th>
                                    <th>k</th>
                                    <th>l</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% locals.mappings.forEach(function(m) { %>
                                    <tr>
                                        <td style="font-weight:bold; background:#f9f9f9;">CO<%= m.numberOfCO %></td>
                                        <% for(let i=0; i<12; i++) { %>
                                            <td><%= m.fromAtoL && m.fromAtoL[i] ? m.fromAtoL[i] : '-' %></td>
                                        <% } %>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <p class="ad-no-content">No course mappings provided.</p>
                    <% } %>

                    <h3 class="ad-section-heading" data-section-key="concept_map">Concept Map</h3>
                    <% if (locals.syl && locals.syl.conceptMap) { %>
                        <div class="ad-concept-map">
                            <img src="<%= locals.syl.conceptMap %>" alt="Concept Map">
                        </div>
                    <% } else { %>
                        <p class="ad-no-content">No concept map image provided.</p>
                    <% } %>

                    <h3 class="ad-section-heading" data-section-key="schedule">Course Schedule</h3>
                    <% if (locals.schedules && locals.schedules.length > 0) { %>
                        <table class="ad-data-table" style="font-size: 0.85rem;">
                            <thead>
                                <tr>
                                    <th style="width: 10%;">Week</th>
                                    <th style="width: 30%;">Topic</th>
                                    <th style="width: 30%;">TLA </th>
                                    <th style="width: 30%;">Assessment Task</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% locals.schedules.forEach(function(s) { %>
                                    <tr>
                                        <td style="font-weight:bold; text-align:center; background:#f9f9f9;">Wk <%= s.week %></td>
                                        <td><%= s.coverageTopic || '-' %></td>
                                        <td>
                                            <div style="margin-bottom:0.25rem;"><strong>Mode:</strong> <%= s.tlaMode || '-' %></div>
                                            <div><strong>Activity:</strong> <%= s.tlaActivities || '-' %></div>
                                        </td>
                                        <td>
                                            <div style="margin-bottom:0.25rem;"><strong>Mode:</strong> <%= s.assessmentTaskMode || '-' %></div>
                                            <div><strong>Task:</strong> <%= s.assessmentTaskTask || '-' %></div>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <p class="ad-no-content">No schedule provided.</p>
                    <% } %>

                    <h3 class="ad-section-heading" data-section-key="evaluation">Course Evaluation</h3>
                    <% if (locals.evaluations && locals.evaluations.length > 0) { %>
                        <p style="font-size:0.85rem; color:#555; margin-bottom:10px;">The final grade of the student is based on the following components:</p>
                        <table class="ad-data-table" style="font-size: 0.85rem; text-align:center;">
                            <thead>
                                <tr>
                                    <th>Module Code</th>
                                    <th>CO</th>
                                    <th style="text-align:left;">Mediating Outcomes</th>
                                    <th>FA %</th>
                                    <th>SA %</th>
                                    <th>Modular Weight %</th>
                                    <th>Final Weight %</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% locals.evaluations.forEach(function(ev) { %>
                                    <tr>
                                        <td><%= ev.moduleCode || '-' %></td>
                                        <td><%= ev.coNumber || '-' %></td>
                                        <td style="text-align:left;"><%= ev.mediatingOutcome || '-' %></td>
                                        <td><%= ev.onlineTaskWeight || '0' %></td>
                                        <td><%= ev.longExaminationWeight || '0' %></td>
                                        <td><%= ev.moduleWeight || '0' %></td>
                                        <td><%= ev.finalWeight || '0' %></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <p class="ad-no-content">No course evaluation provided.</p>
                    <% } %>

                    <h3 class="ad-section-heading" data-section-key="grading">Grading System</h3>
                    <div style="display: flex; gap: 20px; align-items: flex-start; margin-bottom: 20px;">
                        <table class="ad-data-table" style="font-size: 0.85rem; width: 300px; text-align: center;">
                            <thead>
                                <tr><th>Percentage</th><th>Grade</th></tr>
                            </thead>
                            <tbody>
                                <tr><td>100 - 92.75</td><td>1.00</td></tr>
                                <tr><td>92.74 - 86.25</td><td>1.25 - 1.75</td></tr>
                                <tr><td>86.24 - 79.75</td><td>2.00 - 2.25</td></tr>
                                <tr><td>79.74 - 73.25</td><td>2.50 - 2.75</td></tr>
                                <tr><td>73.24 - 70.00</td><td>3.00</td></tr>
                                <tr><td>Below 70</td><td>IP</td></tr>
                            </tbody>
                        </table>
                        <div style="flex: 1; color: #444;">
                            <p style="margin-bottom: 5px;"><strong>Passing Grade:</strong> 1.0 to 3.0 (Obtained above 70%)</p>
                            <p style="margin-bottom: 5px;"><strong>In-Progress (IP):</strong> Obtained below 70%</p>
                            <p><strong>Failing Grade (5.0):</strong> Violation of Academic Integrity</p>
                        </div>
                    </div>

                    <h3 class="ad-section-heading" data-section-key="textbook">Textbook</h3>
                    <div style="margin-bottom: 20px; font-size: 0.9rem; line-height: 1.5; color: #333; white-space: pre-wrap;"><%= locals.syl && locals.syl.textbook ? locals.syl.textbook : 'No textbook specified.' %></div>

                    <h3 class="ad-section-heading" data-section-key="references">References</h3>
                    <div style="margin-bottom: 20px; font-size: 0.9rem; line-height: 1.5; color: #333; white-space: pre-wrap;"><%= locals.syl && locals.syl.references ? locals.syl.references : 'No references specified.' %></div>

                    <h3 class="ad-section-heading" data-section-key="assessment">Course Outcomes Assessment</h3>
                    <% if (locals.cos && locals.cos.length > 0) { %>
                        <p style="font-size:0.85rem; color:#555; margin-bottom:10px;">Achievement of course outcomes is based on the following:</p>
                        <table class="ad-data-table" style="font-size: 0.85rem;">
                            <thead>
                                <tr>
                                    <th style="width:25%;">Course Outcomes</th>
                                    <th style="width:40%;">Assessment Tasks</th>
                                    <th style="width:35%;">Min. Performance</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% locals.cos.forEach(function(co) { %>
                                    <tr>
                                        <td style="font-weight:bold;">CO <%= co.coNumber ? co.coNumber.replace('CO', '') : '-' %></td>
                                        <td><%= co.assessmentTasks || '-' %></td>
                                        <td><%= co.minSatisfactoryPerf || '0' %>%</td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <p class="ad-no-content">No course outcomes assessment provided.</p>
                    <% } %>

                    <!-- â”€â”€ Signature Block for PDF Export â”€â”€ -->
                    <div id="document-signature-section" style="margin-top:2rem; padding-top:1.5rem; border-top:2px solid #e0e0e0; page-break-inside: avoid;">
                        <!-- Row 1: Prepared By + Program Chair + Dean side-by-side -->
                        <div style="display:flex; justify-content:space-evenly; gap:2rem; flex-wrap:wrap; margin-bottom:1.5rem;">
                            <% 
                                const isPcPreparer = locals.facultySignatoryName && locals.pcSignatoryName && (locals.facultySignatoryName === locals.pcSignatoryName);
                                const isDeanPreparer = locals.facultySignatoryName && locals.deanSignatoryName && (locals.facultySignatoryName === locals.deanSignatoryName);
                            %>

                            <% if (isDeanPreparer) { %>
                                <!-- Dean Preparer Signature Only -->
                                <div style="text-align:center; flex:1; min-width:200px;">
                                    <p style="font-weight:600; font-size:0.85rem; color:#666; margin-bottom:8px;">Prepared and Approved by:</p>
                                    <% if (locals.deanSignature) { %>
                                        <div style="margin-bottom:6px;">
                                            <img src="<%= locals.deanSignature %>" alt="Dean Signature" style="max-height:60px; max-width:150px;">
                                        </div>
                                    <% } else { %>
                                        <div style="height:60px; border-bottom:1px solid #999; width:150px; margin:0 auto 6px;"></div>
                                    <% } %>
                                    <p style="font-weight:700; font-size:0.9rem; margin:4px 0 2px;"><%= locals.deanSignatoryName || 'DEAN' %></p>
                                    <p style="font-size:0.8rem; color:#888;">Dean</p>
                                </div>
                            <% } else if (isPcPreparer) { %>
                                <!-- Faculty / PC Combined Signature -->
                                <div style="text-align:center; flex:1; min-width:200px;">
                                    <p style="font-weight:600; font-size:0.85rem; color:#666; margin-bottom:8px;">Prepared & Endorsed by:</p>
                                    <% if (locals.pcSignature) { %>
                                        <div style="margin-bottom:6px;">
                                            <img src="<%= locals.pcSignature %>" alt="PC Signature" style="max-height:60px; max-width:150px;">
                                        </div>
                                    <% } else { %>
                                        <div style="height:60px; border-bottom:1px solid #999; width:150px; margin:0 auto 6px;"></div>
                                    <% } %>
                                    <p style="font-weight:700; font-size:0.9rem; margin:4px 0 2px;"><%= locals.pcSignatoryName || 'PROGRAM CHAIR' %></p>
                                    <p style="font-size:0.8rem; color:#888;">Program Chair</p>
                                </div>
                                <!-- Dean Signature -->
                                <div style="text-align:center; flex:1; min-width:200px;">
                                    <p style="font-weight:600; font-size:0.85rem; color:#666; margin-bottom:8px;">Approved by:</p>
                                    <% if (locals.deanSignature) { %>
                                        <div style="margin-bottom:6px;">
                                            <img src="<%= locals.deanSignature %>" alt="Dean Signature" style="max-height:60px; max-width:150px;">
                                        </div>
                                    <% } else { %>
                                        <div style="height:60px; border-bottom:1px solid #999; width:150px; margin:0 auto 6px;"></div>
                                    <% } %>
                                    <p style="font-weight:700; font-size:0.9rem; margin:4px 0 2px;"><%= locals.deanSignatoryName || 'DEAN' %></p>
                                    <p style="font-size:0.8rem; color:#888;">Dean</p>
                                </div>
                            <% } else { %>
                                <!-- Faculty Signature -->
                                <div style="text-align:center; flex:1; min-width:200px;">
                                    <p style="font-weight:600; font-size:0.85rem; color:#666; margin-bottom:8px;">Prepared by:</p>
                                    <% if (locals.facultySignature) { %>
                                        <div style="margin-bottom:6px;">
                                            <img src="<%= locals.facultySignature %>" alt="Faculty Signature" style="max-height:60px; max-width:150px;">
                                        </div>
                                    <% } else { %>
                                        <div style="height:60px; border-bottom:1px solid #999; width:150px; margin:0 auto 6px;"></div>
                                    <% } %>
                                    <p style="font-weight:700; font-size:0.9rem; margin:4px 0 2px;"><%= locals.facultySignatoryName || 'FACULTY' %></p>
                                    <p style="font-size:0.8rem; color:#888;">Course Coordinator</p>
                                </div>
                                <!-- Program Chair Signature -->
                                <div style="text-align:center; flex:1; min-width:200px;">
                                    <p style="font-weight:600; font-size:0.85rem; color:#666; margin-bottom:8px;">Endorsed by:</p>
                                    <% if (locals.pcSignature) { %>
                                        <div style="margin-bottom:6px;">
                                            <img src="<%= locals.pcSignature %>" alt="PC Signature" style="max-height:60px; max-width:150px;">
                                        </div>
                                    <% } else { %>
                                        <div style="height:60px; border-bottom:1px solid #999; width:150px; margin:0 auto 6px;"></div>
                                    <% } %>
                                    <p style="font-weight:700; font-size:0.9rem; margin:4px 0 2px;"><%= locals.pcSignatoryName || 'PROGRAM CHAIR' %></p>
                                    <p style="font-size:0.8rem; color:#888;">Program Chair</p>
                                </div>
                                <!-- Dean Signature -->
                                <div style="text-align:center; flex:1; min-width:200px;">
                                    <p style="font-weight:600; font-size:0.85rem; color:#666; margin-bottom:8px;">Approved by:</p>
                                    <% if (locals.deanSignature) { %>
                                        <div style="margin-bottom:6px;">
                                            <img src="<%= locals.deanSignature %>" alt="Dean Signature" style="max-height:60px; max-width:150px;">
                                        </div>
                                    <% } else { %>
                                        <div style="height:60px; border-bottom:1px solid #999; width:150px; margin:0 auto 6px;"></div>
                                    <% } %>
                                    <p style="font-weight:700; font-size:0.9rem; margin:4px 0 2px;"><%= locals.deanSignatoryName || 'DEAN' %></p>
                                    <p style="font-size:0.8rem; color:#888;">Dean</p>
                                </div>
                            <% } %>
                        </div>
                        <!-- Row 2: HR Signature below -->
                        <div style="display:flex; justify-content:center;">
                            <div style="text-align:center; min-width:200px;">
                                <p style="font-weight:600; font-size:0.85rem; color:#666; margin-bottom:8px;">Archived by:</p>
                                <% if (locals.hrSignature) { %>
                                    <div style="margin-bottom:6px;">
                                        <img src="<%= locals.hrSignature %>" alt="HR Signature" style="max-height:60px; max-width:150px;">
                                    </div>
                                <% } else { %>
                                    <div id="preview-signature-img-container" style="margin-bottom:6px; height:60px; max-width:150px; margin:0 auto;">
                                        <!-- HR signature image will be placed here by JS -->
                                        <div style="height:60px; border-bottom:1px solid #999; width:150px; margin:0 auto 6px;"></div>
                                    </div>
                                <% } %>
                                <p id="preview-signatory-name" style="font-weight:700; font-size:0.9rem; margin:4px 0 2px;"><%= locals.hrSignatoryName || 'HR ADMIN' %></p>
                                <p style="font-size:0.8rem; color:#888;">HR Administrator</p>
                            </div>
                        </div>
                    </div>

                </div>
            </section>

            <!-- â”€â”€â”€ RIGHT: Approval Sidebar â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <aside class="ad-sidebar">

                <h3 class="ad-sidebar-title">HR Final Review</h3>

                <!-- â”€â”€ Approval Progress Tracker â”€â”€ -->
                <div class="ad-tracker">
                    <% const steps=[ { role: 'Faculty' , label: 'Submitted' , status: 'approved' }, { role: 'Program Chair' , label: 'Endorsed' ,
                        status: 'approved' }, { role: 'Dean' , label: 'Approved' , status: 'approved' }, { role: 'HR' ,
                        label: 'Final Review' , status: locals.currentStatus === 'Archived' ? 'approved' : 'ongoing' } ]; %>

                        <div class="ad-tracker-steps">
                            <% steps.forEach(function(step, idx) { %>
                                <div class="ad-tracker-step">
                                    <div class="ad-step-dot step-<%= step.status %>"></div>
                                    <% if (idx < steps.length - 1) { %>
                                        <div class="ad-step-line line-<%= step.status %>"></div>
                                        <% } %>
                                            <div class="ad-step-labels">
                                                <span class="ad-step-role">
                                                    <%= step.role %>
                                                </span>
                                                <span class="ad-step-sublabel">
                                                    <%= step.label %>
                                                </span>
                                            </div>
                                </div>
                                <% }); %>
                        </div>
                </div>

                <!-- â”€â”€ Comments â”€â”€ -->
                <div class="ad-sidebar-section">
                    <label class="ad-sidebar-label">Comments</label>
                    <% if (locals.currentStatus === 'Archived') { %>
                        <div class="ad-comments-box" style="background:#f5f5f5; padding:10px; border-radius:6px; min-height:60px; color:#555; font-size:0.9rem;">
                            <%= locals.existingComment || 'No comments.' %>
                        </div>
                    <% } else { %>
                        <textarea id="approval-comments" class="ad-comments-box" rows="5"
                            placeholder="Add comments about the review..."></textarea>
                    <% } %>
                </div>

                <% if (locals.currentStatus !== 'Archived') { %>
                <!-- â”€â”€ Status Dropdown â”€â”€ -->
                <div class="ad-sidebar-section">
                    <label class="ad-sidebar-label">Status</label>
                    <div class="ad-status-select-wrapper">
                        <span class="ad-status-indicator" id="status-indicator"></span>
                        <select id="approval-status" class="ad-status-select">
                            <option value="Archived" <%=locals.currentStatus==='Archived' ? 'selected' : 'selected' %>
                                >Verified
                            </option>
                            <option value="Returned" <%=locals.currentStatus==='Returned' ? 'selected' : '' %>>Returned
                            </option>
                        </select>
                    </div>
                </div>

                <!-- â”€â”€ Signature Box â”€â”€ -->
                <div class="ad-sidebar-section" id="signature-section">
                    <label class="ad-sidebar-label">Signatory Name</label>
                    <input type="text" id="signatory-name-input" class="ad-comments-box" 
                        value="<%= locals.hrSignatoryName || (locals.user ? locals.user.firstName + ' ' + locals.user.lastName : '') %>"
                        placeholder="e.g. HR Administrator" 
                        style="margin-bottom: 15px; padding: 10px 12px; height: 40px; box-sizing: border-box;">

                    <label class="ad-sidebar-label">E-Signature</label>

                    <!-- Signature Tab Switcher -->
                    <div class="ad-sig-tabs">
                        <button type="button" class="ad-sig-tab active" data-tab="upload">Upload</button>
                        <button type="button" class="ad-sig-tab" data-tab="draw">Draw</button>
                    </div>

                    <!-- Upload Tab -->
                    <div class="ad-sig-tab-content" id="sig-tab-upload">
                        <div class="ad-signature-wrapper">
                            <div class="ad-signature-box" id="signature-box">
                                <span class="ad-signature-placeholder">Click to upload signature</span>
                                <input type="file" id="signature-upload" accept="image/*" hidden>
                            </div>
                            <button type="button" class="ad-signature-remove-btn" id="signature-remove"
                                title="Remove signature" style="display: none;">
                                <span class="material-symbols-outlined">cancel</span>
                            </button>
                        </div>
                    </div>

                    <!-- Draw Tab -->
                    <div class="ad-sig-tab-content" id="sig-tab-draw" style="display: none;">
                        <canvas id="signature-canvas" class="ad-signature-canvas" width="220" height="80"></canvas>
                        <div class="ad-sig-draw-actions">
                            <button type="button" class="ad-sig-draw-btn ad-sig-clear-btn" id="sig-clear-canvas">Clear</button>
                            <button type="button" class="ad-sig-draw-btn ad-sig-use-btn" id="sig-use-drawn">Use This Signature</button>
                        </div>
                    </div>
                </div>
                <% } else { %>
                <!-- â”€â”€ Archived Status Badge â”€â”€ -->
                <div class="ad-sidebar-section">
                    <label class="ad-sidebar-label">Status</label>
                    <div style="display:flex;align-items:center;gap:8px;padding:8px 12px;background:#e8f5e9;border-radius:6px;">
                        <span class="material-symbols-outlined" style="color:#2e7d32;">check_circle</span>
                        <span style="font-weight:600;color:#2e7d32;">Verified</span>
                    </div>
                </div>
                <% } %>

                <!-- â”€â”€ Action Buttons â”€â”€ -->
                <div class="ad-sidebar-actions">
                    <button type="button" class="ad-btn-action ad-btn-pdf" id="btn-save-pdf">
                        <span class="material-symbols-outlined">picture_as_pdf</span>
                        Download PDF
                    </button>
                    <% if (locals.currentStatus !== 'Archived') { %>
                    <button type="button" class="ad-btn-action ad-btn-submit archive-btn"
                        data-id="<%= locals.syllabusId %>" id="btn-submit">
                        <span class="material-symbols-outlined">check_circle</span>
                        Verify
                    </button>
                    <% } %>
                </div>
            </aside>

        </div>
    </main>

    <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
         Hidden data attributes for JS
    â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
    <script type="application/json" id="section-comments-data">
        <%- JSON.stringify(locals.sectionComments || []) %>
    </script>
    <script>
        const SYLLABUS_APPROVAL_DATA = {
            syllabusId: '<%= locals.syllabusId || "" %>',
            userRole: 'hr',
            postUrl: '/syllabus/hr/archive/<%= locals.syllabusId || "" %>',
            backUrl: '/syllabus/hr',
            actionLabel: 'archive'
        };
    </script>
    <script src="/Syllabus/js/syllabusApprovalDetail.js?v=3"></script>
    <script src="/Syllabus/js/sectionComments.js?v=2"></script>

    </script>
</body>

</html>
